{
  "name": "@gander/monkey-redmine-time-widget",
  "description": "Redmine Widget for total dev time presentation",
  "author": "Adam Gąsowski",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitArgs": [
        "-S"
      ]
    },
    "github": {
      "release": true,
      "draft": true,
      "assets": [
        "dist/**/*.js"
      ],
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": [
        "npm run build",
        "auto-changelog --package --commit-limit false --template keepachangelog --hide-credit"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "release": "release-it --"
  },
  "dependencies": {
    "pinia": "^4.0.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "auto-changelog": "^2.4.0",
    "release-it": "^21.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-monkey": "^8.1.1",
    "vue-tsc": "^3.0.0"
  }
}
